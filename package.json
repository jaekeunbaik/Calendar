{
  "name": "calendar",
  "version": "1.0.0",
  "description": "Desktop Calendar & Todo Widget",
  "main": "electron/main.cjs",
  "repository": {
    "type": "git",
    "url": "https://github.com/jaekeunbaik/Calendar.git"
  },
  "homepage": "https://jaekeunbaik.github.io/Calendar/",
  "scripts": {
    "dev": "concurrently -k \"npm run dev:vite\" \"wait-on tcp:5173 && npm run dev:electron\"",
    "dev:vite": "vite",
    "dev:electron": "cross-env NODE_ENV=development ELECTRON_RUN_AS_NODE= electron .",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "start": "cross-env ELECTRON_RUN_AS_NODE= electron .",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder"
  },
  "keywords": [
    "electron",
    "react",
    "calendar",
    "widget",
    "desktop"
  ],
  "author": "jaekeunbaik",
  "license": "ISC",
  "dependencies": {
    "date-fns": "^4.4.0",
    "lucide-react": "^1.70.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "autoprefixer": "^10.6.2",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "wait-on": "^9.5.1"
  },
  "build": {
    "appId": "com.jaekeunbaik.calendar",
    "productName": "DesktopCalendar",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "zip"
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "데스크탑 캘린더"
    }
  }
}
